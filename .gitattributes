# 项目统一编码协议 —— GitAttributes
# 目标：Git 存储统一 UTF-8 文本，换行符统一 LF，避免 CRLF/LF 混战

# 默认：文本文件自动检测换行符，入库统一 LF
* text=auto eol=lf

# C# 源文件：统一 LF（Unity 支持 LF，避免平台差异）
*.cs text eol=lf

# PowerShell：统一 LF + UTF-8（PS 5.1 靠 BOM 识别，BOM 由 .editorconfig 保证）
*.ps1 text eol=lf

# Python / JS / JSON / MD：统一 LF
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 批处理必须 CRLF（cmd 对 LF 敏感）
*.cmd text eol=crlf
*.bat text eol=crlf

# ---- 二进制文件标记（避免被 text=auto 误伤）----
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.unity3d binary
*.asset binary
*.mat binary
*.prefab binary
*.anim binary
*.controller binary
*.unitypackage binary

# Unity .meta 实为 YAML 文本，但含大量 GUID 且改动频繁，不参与 diff/合并
*.meta merge=binary
